<Window x:Class="PS2FTPCONNECTOR.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PS2FTPCONNECTOR"
        mc:Ignorable="d"
        Title="PS2FTPCONNECTOR // BATCH MATRIX CONTROL" 
        Height="860" Width="1120" AllowsTransparency="True"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip" 
        WindowStyle="None" Background="{x:Null}">

    <Window.Resources>
        <DropShadowEffect x:Key="NeonGlow" Color="#00E5FF" BlurRadius="16" ShadowDepth="0" Opacity="0.75"/>
        <DropShadowEffect x:Key="GreenGlow" Color="#00FF66" BlurRadius="14" ShadowDepth="0" Opacity="0.65"/>
        <DropShadowEffect x:Key="RedGlow" Color="#FF3C3C" BlurRadius="14" ShadowDepth="0" Opacity="0.65"/>
        <DropShadowEffect x:Key="TextGlow" Color="#00E5FF" BlurRadius="8" ShadowDepth="0" Opacity="0.7"/>

        <LinearGradientBrush x:Key="SmokeyGlassBg" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#E6080C16" Offset="0.0"/>
            <GradientStop Color="#CC0F172A" Offset="0.5"/>
            <GradientStop Color="#E6060911" Offset="1.0"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="GlassCardBg" Color="#550D1424"/>
        <SolidColorBrush x:Key="GlassBorder" Color="#4400E5FF"/>

        <Style TargetType="TabItem">
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{TemplateBinding Content}" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Padding="12,6"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Background" Value="#66111827"/>
            <Setter Property="Foreground" Value="#7A95BE"/>
            <Setter Property="BorderBrush" Value="#3300E5FF"/>
        </Style>

        <Style x:Key="CyberButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="1.0"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#00E5FF" BlurRadius="14" ShadowDepth="0" Opacity="0.8"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.30"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NeonProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="TemplateRoot">
                            <Border x:Name="PART_Track" Background="#44070A12" BorderBrush="#4400E5FF" BorderThickness="1" CornerRadius="4"/>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="3" Margin="1">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#FF0066FF" Offset="0.0"/>
                                        <GradientStop Color="#FF00E5FF" Offset="0.7"/>
                                        <GradientStop Color="#FF00FFCC" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect Color="#00E5FF" BlurRadius="14" ShadowDepth="0" Opacity="0.9"/>
                                </Border.Effect>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource SmokeyGlassBg}" BorderBrush="#5500E5FF" BorderThickness="1.5" CornerRadius="12" Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="0" Opacity="0.85"/>
        </Border.Effect>

        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="190"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ROW 0: Header -->
            <Border Grid.Row="0" BorderBrush="#00E5FF" BorderThickness="0,0,0,1" Padding="0,0,0,15" Margin="0,0,0,15">
                <Grid>
                    <StackPanel HorizontalAlignment="Left">
                        <TextBlock Text="PS2 // MULTI-ISO BATCH INJECTOR" FontSize="24" FontWeight="Bold" FontFamily="Consolas" Effect="{StaticResource TextGlow}">
                            <TextBlock.Foreground>
                                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                    <GradientStop Color="#FF0C7FFF"/>
                                    <GradientStop Color="#FF560C7B" Offset="0.738"/>
                                    <GradientStop Color="#FF00E2FF" Offset="0.301"/>
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                        </TextBlock>
                        <TextBlock Text="READY FOR MULTI-THREADED DATA STACKING OVER TCP/IP..." Foreground="#FF08C8F9" FontSize="11" FontFamily="Georgia" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="{StaticResource GlassCardBg}" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1" CornerRadius="6" Padding="14,8">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,4">
                                <TextBlock Text="● " Foreground="#00FF66" FontFamily="Consolas" FontSize="12" Effect="{StaticResource GreenGlow}"/>
                                <TextBlock x:Name="TxtQueueStatus" Text="QUEUE: 0 GAMES LOADED" Foreground="#00FF66" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Effect="{StaticResource GreenGlow}"/>
                            </StackPanel>
                            <Separator Background="#3300E5FF" Margin="0,1,0,3"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="HDD_STORAGE // " Foreground="#7A95BE" FontFamily="Consolas" FontSize="12" FontWeight="Bold"/>
                                <TextBlock x:Name="TxtFreeSpace" Text="PS2 FREE SPACE: -- GB" Foreground="#00E5FF" FontFamily="Consolas" FontSize="13" FontWeight="Bold" Effect="{StaticResource TextGlow}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            <!-- ROW 1: Main Content -->
            <Grid Grid.Row="1" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="420"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT COLUMN: Controls -->
                <StackPanel Grid.Column="0" VerticalAlignment="Top">
                    <Border Background="{StaticResource GlassCardBg}" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="[ &#x26a1;TARGET_IP ]" Foreground="#00E5FF" FontFamily="Consolas" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtIpAddress" Grid.Column="1" Text="192.168.0.103" Background="#88070A12" Foreground="#FFFFFF" BorderBrush="#00E5FF" CaretBrush="#00E5FF" Padding="6" FontSize="13" FontFamily="ROG Fonts" VerticalAlignment="Center"/>
                            <Button x:Name="BtnConnect" Grid.Column="2" Style="{StaticResource CyberButtonStyle}" Content="CONNECT" FontFamily="Consolas" FontWeight="Bold" FontSize="11" Margin="8,0,0,0" Padding="0,6" Background="#88111827" Foreground="#00FF66" BorderBrush="#00FF66" BorderThickness="1" Effect="{StaticResource GreenGlow}" Click="BtnConnect_Click"/>
                        </Grid>
                    </Border>

                    <Border Background="{StaticResource GlassCardBg}" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="// SELECTED NODE EDITOR (QUEUE)" Foreground="#5A759E" FontFamily="Consolas" FontWeight="Bold" FontSize="11" Margin="0,0,0,8"/>
                            <TextBlock Text="DATA_LABEL:" Foreground="#FF00E5FF" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Margin="0,2,0,2"/>
                            <TextBox x:Name="TxtGameTitle" Background="#88070A12" BorderBrush="#3300E5FF" Padding="5" FontFamily="Georgia" LostFocus="TxtGameTitle_LostFocus" FontSize="14">
                                <TextBox.Foreground>
                                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                        <GradientStop Color="#FF00F9FF"/>
                                        <GradientStop Color="#FF0413FF" Offset="1"/>
                                    </LinearGradientBrush>
                                </TextBox.Foreground>
                            </TextBox>
                            <TextBlock Text="CORE_ID:" Foreground="#FF00E5FF" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Margin="0,8,0,2"/>
                            <TextBox x:Name="TxtGameId" Background="#88070A12" BorderBrush="#3300E5FF" Padding="5" Width="180" HorizontalAlignment="Left" FontFamily="Consolas" FontWeight="Bold" LostFocus="TxtGameId_LostFocus">
                                <TextBox.Foreground>
                                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                        <GradientStop Color="#FF00D6FF"/>
                                        <GradientStop Color="#FF0004FF" Offset="1"/>
                                    </LinearGradientBrush>
                                </TextBox.Foreground>
                            </TextBox>
                        </StackPanel>
                    </Border>

                    <Button x:Name="BtnBrowse" Style="{StaticResource CyberButtonStyle}" Content="[ + ] LOAD MULTIPLE ISO'S" FontFamily="Consolas" FontWeight="Bold" Margin="0,0,0,8" Padding="0,12" Background="#99081F3E" Foreground="#00E5FF" BorderBrush="#FF08C1FF" BorderThickness="1" Click="BtnBrowse_Click" FontSize="13"/>
                    <Button x:Name="BtnClearQueue" Style="{StaticResource CyberButtonStyle}" Content="[ X ] CLEAR QUEUE" FontFamily="Consolas" FontWeight="Bold" Margin="0,0,0,8" Padding="0,8" Background="#991A1118" Foreground="#FF3C3C" BorderBrush="#FF3C3C" BorderThickness="1" Click="BtnClearQueue_Click" FontSize="11"/>
                    <Button x:Name="BtnPowerOff" Style="{StaticResource CyberButtonStyle}" Content="[ ⏻ ] POWER OFF PS2 CONSOLE" FontFamily="Consolas" FontWeight="Bold" Margin="0,0,0,8" Padding="0,9" Background="#991F1209" Foreground="#FF9900" BorderBrush="#FF9900" BorderThickness="1" Click="BtnPowerOff_Click" FontSize="11"/>
                    <Button Style="{StaticResource CyberButtonStyle}" Content="[ ESC ] EXIT PROGRAM" FontFamily="Consolas" FontWeight="Bold" Padding="0,8" Background="#99141414" Foreground="#FFFFD306" BorderBrush="#FFF3CA09" BorderThickness="1" Click="Button_Click" FontSize="11"/>
                </StackPanel>

                <!-- RIGHT COLUMN: Tabs -->
                <TabControl Grid.Column="2" Background="#66070A12" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1">
                    <TabItem Header=" &#x25b6; BATCH UPLOAD QUEUE  " Background="{x:Null}" FontSize="14">
                        <TabItem.Foreground>
                            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                <GradientStop Color="#FF0408FF" Offset="1"/>
                                <GradientStop Color="#FF00FFED" Offset="0"/>
                            </LinearGradientBrush>
                        </TabItem.Foreground>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ListView x:Name="LvQueue" Grid.Row="0" BorderThickness="0" FontFamily="Georgia" SelectionChanged="LvQueue_SelectionChanged" AllowDrop="True" DragOver="LvQueue_DragOver" Drop="LvQueue_Drop" Margin="5" Background="#01000000" FontSize="14">
                                <ListView.Foreground>
                                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                        <GradientStop Color="#FF00F9FF"/>
                                        <GradientStop Color="#FF0816F5" Offset="1"/>
                                    </LinearGradientBrush>
                                </ListView.Foreground>
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="&#x231b;STATUS" Width="110">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Status}" FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#5A759E"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="QUEUED">
                                                                        <Setter Property="Foreground" Value="#00E5FF"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="SKIPPED">
                                                                        <Setter Property="Foreground" Value="#A0A0AA"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="UPLOADING...">
                                                                        <Setter Property="Foreground" Value="#FFFF00"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="DONE">
                                                                        <Setter Property="Foreground" Value="#00FF66"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="FAILED">
                                                                        <Setter Property="Foreground" Value="#FF3C3C"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="&#x1f525;CORE_ID" DisplayMemberBinding="{Binding GameId}" Width="110"/>
                                        <GridViewColumn Header="&#x1f4be;SIZE" DisplayMemberBinding="{Binding SizeText}" Width="85"/>
                                        <GridViewColumn Header="&#x2699;DATA_LABEL (CLICK TO EDIT)" DisplayMemberBinding="{Binding Title}" Width="280"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>

                            <Border Grid.Row="1" Background="{StaticResource GlassCardBg}" BorderBrush="{StaticResource GlassBorder}" BorderThickness="0,1,0,0" Padding="10,7">
                                <CheckBox x:Name="ChkOverwriteDuplicates" Content="OVERWRITE EXISTING GAMES ON PS2 (Unchecked = Skip duplicates already installed)" Foreground="#00E5FF" FontFamily="Consolas" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </TabItem>

                    <TabItem Header=" &#x25bc; INSTALLED GAMES ON PS2  ">
                        <TabItem.Foreground>
                            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                <GradientStop Color="#FF0010FF" Offset="1"/>
                                <GradientStop Color="#FF00F9FF" Offset="0"/>
                            </LinearGradientBrush>
                        </TabItem.Foreground>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ListView x:Name="LvPs2Disk" Grid.Row="0" Background="Transparent" BorderThickness="0" FontFamily="Consolas" Margin="5" SelectionChanged="LvPs2Disk_SelectionChanged" FontSize="16">
                                <ListView.Foreground>
                                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                        <GradientStop Color="#FF00F9FF"/>
                                        <GradientStop Color="#FF0816F5" Offset="1"/>
                                    </LinearGradientBrush>
                                </ListView.Foreground>
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="GAME DISC ID" DisplayMemberBinding="{Binding GameId}" Width="150"/>
                                        <GridViewColumn Header="GAME TITLE ON HARD DRIVE" DisplayMemberBinding="{Binding Title}" Width="400"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>

                            <TextBlock x:Name="TxtNoConnection" Grid.Row="0" Text="&#x26a0; NO LIVE CONNECTION // CLICK 'CONNECT' TO SCAN CONSOLE &#x26a0;" Foreground="#FF3C3C" FontFamily="Consolas" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            <Border Grid.Row="1"
                                    Background="{StaticResource GlassCardBg}"
                                    BorderBrush="{StaticResource GlassBorder}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8"
                                    Margin="10,2,10,5"
                                    TextOptions.TextFormattingMode="Display"
                                    TextOptions.TextRenderingMode="ClearType"
                                    UseLayoutRounding="True"
                                    Panel.ZIndex="1">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="EDIT TITLE:" Foreground="#00E5FF" FontFamily="Consolas" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox x:Name="TxtEditPs2Title" Grid.Column="1" Background="#88070A12" Foreground="#FFFFFF" BorderBrush="#3300E5FF" Padding="4" FontFamily="Consolas" FontSize="12"/>
                                        <Button x:Name="BtnSaveGameSettings" Grid.Column="3" Style="{StaticResource CyberButtonStyle}" Content="[ ✓ ] SAVE SETTINGS" FontFamily="Consolas" FontWeight="Bold" FontSize="11" Padding="12,5" Background="#880A291A" Foreground="#00FF66" BorderBrush="#00FF66" BorderThickness="1" IsEnabled="False" Click="BtnSaveGameSettings_Click"/>
                                    </Grid>

                                    <UniformGrid Columns="4" Rows="2" Panel.ZIndex="1">
                                        <CheckBox x:Name="ChkMode1" Content="Mode 1 (Accurate Reads)" Foreground="#A0A0AA" FontFamily="Consolas" FontSize="12" Margin="2"/>
                                        <CheckBox x:Name="ChkMode2" Content="Mode 2 (Sync Mode)" Foreground="#A0A0AA" FontFamily="Consolas" FontSize="12" Margin="2"/>
                                        <CheckBox x:Name="ChkMode3" Content="Mode 3 (Unhook Syscalls)" Foreground="#A0A0AA" FontFamily="Consolas" FontSize="12" Margin="2"/>
                                        <CheckBox x:Name="ChkMode4" Content="Mode 4 (Skip Videos)" Foreground="#A0A0AA" FontFamily="Consolas" FontSize="12" Margin="2"/>
                                        <CheckBox x:Name="ChkMode5" Content="Mode 5 (Emulate DVD-DL)" Foreground="#A0A0AA" FontFamily="Consolas" FontSize="12" Margin="2"/>
                                        <CheckBox x:Name="ChkMode6" Content="Mode 6 (Disable IGR)" Foreground="#A0A0AA" FontFamily="Consolas" FontSize="12" Margin="2"/>
                                        <CheckBox x:Name="ChkMode7" Content="Mode 7 (High Module)" Foreground="#A0A0AA" FontFamily="Consolas" FontSize="12" Margin="2"/>
                                        <CheckBox x:Name="ChkMode8" Content="Mode 8 (Hide Dev9)" Foreground="#A0A0AA" FontFamily="Consolas" FontSize="12" Margin="2"/>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <Grid Grid.Row="2" Margin="10,2,10,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button x:Name="BtnReloadGames" Grid.Column="0" Style="{StaticResource CyberButtonStyle}" Content="[ &#x21bb; ] RELOAD" FontFamily="Consolas" FontWeight="Bold" FontSize="11" Padding="0,9" Background="#88111827" Foreground="#00FF66" BorderBrush="#00FF66" BorderThickness="1" IsEnabled="False" Click="BtnReloadGames_Click"/>
                                <Button x:Name="BtnBackupGame" Grid.Column="2" Style="{StaticResource CyberButtonStyle}" Content="[ &#x1f310; ] BACKUP TO ISO" FontFamily="Consolas" FontWeight="Bold" FontSize="11" Padding="0,9" Background="#880A192F" Foreground="#00E5FF" BorderBrush="#00E5FF" BorderThickness="1" IsEnabled="False" Click="BtnBackupGame_Click"/>
                                <Button x:Name="BtnDeleteGame" Grid.Column="4" Style="{StaticResource CyberButtonStyle}" Content="[ &#x1f5d1; ] DELETE" FontFamily="Consolas" FontWeight="Bold" FontSize="11" Padding="0,9" Background="#881A1118" Foreground="#FF3C3C" BorderBrush="#FF3C3C" BorderThickness="1" IsEnabled="False" Click="BtnDeleteGame_Click"/>
                            </Grid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>

            <!-- ROW 2: Log Terminal -->
            <Border Grid.Row="2" Background="#66050811" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,15">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock Text="[ LOG MATRIX TERMINAL // AUTO-SAVING TO \LOGS ]" Foreground="#5A759E" FontFamily="Consolas" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button x:Name="BtnSaveLog" Style="{StaticResource CyberButtonStyle}" Content="[ 💾 ] SAVE LOG AS..." HorizontalAlignment="Right" Padding="10,3" Background="#880A192F" Foreground="#00E5FF" BorderBrush="#00E5FF" BorderThickness="1" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Click="BtnSaveLog_Click"/>
                    </Grid>
                    <TextBox x:Name="TxtLog" Background="Transparent" BorderThickness="0" FontFamily="Consolas" FontSize="12" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" AcceptsReturn="True">
                        <TextBox.Foreground>
                            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                <GradientStop Color="#FF00FFE2"/>
                                <GradientStop Color="#FF122BFF" Offset="1"/>
                            </LinearGradientBrush>
                        </TextBox.Foreground>
                    </TextBox>
                </DockPanel>
            </Border>

            <!-- ROW 3: Status, Speed, ProgressBar & Action Buttons -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Center">
                    <Grid Margin="0,0,0,4">
                        <TextBlock x:Name="StatusText" Text=">> AWAITING OPERATOR DATA RECRUITMENT..." Foreground="#5A759E" FontFamily="Consolas" FontSize="12" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="PercentageText" Text="00.0%" Foreground="#00E5FF" FontFamily="Consolas" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right" Effect="{StaticResource TextGlow}"/>
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <TextBlock Text="XFER_SPEED: " Foreground="#5A759E" FontFamily="Consolas" FontSize="11"/>
                            <TextBlock x:Name="TxtSpeed" Text="0.00 MB/s" Foreground="#FFFF00" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Margin="5,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="TIME_REMAINING: " Foreground="#5A759E" FontFamily="Consolas" FontSize="11"/>
                            <TextBlock x:Name="TxtEta" Text="00:00:00" Foreground="#00FF66" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Margin="5,0,0,0"/>
                        </StackPanel>
                    </Grid>

                    <ProgressBar x:Name="MyProgressBar" Style="{StaticResource NeonProgressBarStyle}" Height="16" Minimum="0" Maximum="100" Value="0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button x:Name="BtnStopBatch" Style="{StaticResource CyberButtonStyle}" Content="[ ⏹ ] SAFE STOP" Padding="18,0" Height="50" Margin="0,0,10,0" Background="#88261014" Foreground="#FF9900" BorderBrush="#FF9900" BorderThickness="1.2" FontFamily="Consolas" FontSize="12" FontWeight="Bold" IsEnabled="False" Click="BtnStopBatch_Click"/>
                    <Button x:Name="BtnInstall" Style="{StaticResource CyberButtonStyle}" Content="[ &#x25b6; EXECUTE BATCH STREAM ]" Padding="24,0" Width="260" Height="50" Background="#00E5FF" Foreground="#070A12" FontFamily="Consolas" FontSize="14" FontWeight="Bold" BorderThickness="0" Effect="{StaticResource NeonGlow}" Click="BtnInstall_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>


            