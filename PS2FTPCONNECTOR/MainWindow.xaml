<Window x:Class="PS2FTPCONNECTOR.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PS2FTPCONNECTOR"
        mc:Ignorable="d"
        Title="PS2FTPCONNECTOR // BATCH MATRIX CONTROL" 
        Height="860" 
        Width="1120"
        Background="#0B0F19"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip" WindowStyle="None">

    <Window.Resources>
        <DropShadowEffect x:Key="NeonGlow" Color="#00E5FF" BlurRadius="12" ShadowDepth="0" Opacity="0.6"/>
        <DropShadowEffect x:Key="GreenGlow" Color="#00FF66" BlurRadius="10" ShadowDepth="0" Opacity="0.5"/>
        <DropShadowEffect x:Key="TextGlow" Color="#00E5FF" BlurRadius="6" ShadowDepth="0" Opacity="0.5"/>

        <Style TargetType="TabItem">
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{TemplateBinding Content}" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Padding="12,6"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Background" Value="#111827"/>
            <Setter Property="Foreground" Value="#5A759E"/>
            <Setter Property="BorderBrush" Value="#1F293D"/>
        </Style>
        <Style x:Key="CyberButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                        Background="{TemplateBinding Background}" 
                        BorderBrush="{TemplateBinding BorderBrush}" 
                        BorderThickness="{TemplateBinding BorderThickness}" 
                        CornerRadius="3" 
                        Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>



    </Window.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="190"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- RIJ 0: Header -->
        <Border Grid.Row="0" BorderBrush="#00E5FF" BorderThickness="0,0,0,1" Padding="0,0,0,15" Margin="0,0,0,15">
            <Grid>
                <StackPanel HorizontalAlignment="Left">
                    <TextBlock Text="PS2 // MULTI-ISO BATCH INJECTOR" FontSize="24" FontWeight="Bold" FontFamily="Consolas" Effect="{StaticResource TextGlow}">
                        <TextBlock.Foreground>
                            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                <GradientStop Color="#FF0C7FFF"/>
                                <GradientStop Color="#FF560C7B" Offset="0.738"/>
                                <GradientStop Color="#FF00E2FF" Offset="0.301"/>
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                    </TextBlock>
                    <TextBlock Text="READY FOR MULTI-THREADED DATA STACKING OVER TCP/IP..." Foreground="#5A759E" FontSize="11" FontFamily="Consolas" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,0">
                    <TextBlock x:Name="TxtQueueStatus" Text="QUEUE: 0 GAMES LOADED" Foreground="#00FF66" FontFamily="Consolas" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="TxtFreeSpace" Text="PS2 FREE SPACE: -- GB" Foreground="#00E5FF" FontFamily="Consolas" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
        <!-- RIJ 1: Hoofdcontent (Links Controls, Rechts Tabbladen) -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Linkerkolom -->
            <StackPanel Grid.Column="0" VerticalAlignment="Top">
                <Border BorderBrush="#1F293D" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="[ TARGET_IP ]" Foreground="#00E5FF" FontFamily="Consolas" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtIpAddress" Grid.Column="1" Text="192.168.0.111" Background="#070A12" Foreground="#FFFFFF" BorderBrush="#00E5FF" CaretBrush="#00E5FF" Padding="6" FontSize="13" FontFamily="Consolas" VerticalAlignment="Center"/>
                        <Button x:Name="BtnConnect" Grid.Column="2" Content="CONNECT" FontFamily="Consolas" FontWeight="Bold" FontSize="11" Margin="8,0,0,0" Padding="0,6" Background="#111827" Foreground="#00FF66" BorderBrush="#00FF66" BorderThickness="1" Effect="{StaticResource GreenGlow}" Click="BtnConnect_Click"/>
                    </Grid>
                </Border>

                <Border BorderBrush="#1F293D" BorderThickness="1" CornerRadius="4" Padding="15">
                    <StackPanel>
                        <TextBlock Text="// SELECTED NODE EDITOR" Foreground="#5A759E" FontFamily="Consolas" FontWeight="Bold" FontSize="12" Margin="0,0,0,10"/>
                        <TextBlock Text="DATA_LABEL:" Foreground="#FF00E5FF" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Margin="0,5,0,2"/>
                        <TextBox x:Name="TxtGameTitle" Background="#070A12" Foreground="#FF3CEC0D" BorderBrush="#1F293D" Padding="6" FontFamily="Consolas" LostFocus="TxtGameTitle_LostFocus"/>
                        <TextBlock Text="CORE_ID:" Foreground="#FF00E5FF" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Margin="0,10,0,2"/>
                        <TextBox x:Name="TxtGameId" Background="#070A12" Foreground="#FF3CEC0D" BorderBrush="#1F293D" Padding="6" Width="180" HorizontalAlignment="Left" FontFamily="Consolas" FontWeight="Bold" LostFocus="TxtGameId_LostFocus"/>
                    </StackPanel>
                </Border>

                <Button x:Name="BtnBrowse" Content="[ + ] LOAD MULTIPLE ISO'S" FontFamily="Consolas" FontWeight="Bold" Margin="0,15,0,0" Padding="0,14" Background="#1F293D" Foreground="#00E5FF" BorderBrush="#FF00FF10" BorderThickness="1" Click="BtnBrowse_Click" FontSize="13"/>
                <Button x:Name="BtnClearQueue" Content="[ X ] CLEAR QUEUE" FontFamily="Consolas" FontWeight="Bold" Margin="0,10,0,0" Padding="0,8" Background="#1A1118" Foreground="#FF3C3C" BorderBrush="#FF3C3C" BorderThickness="1" Click="BtnClearQueue_Click" FontSize="11"/>
            </StackPanel>

            <!-- Rechterkolom -->
            <TabControl Grid.Column="2" Background="#070A12" BorderBrush="#1F293D" BorderThickness="1">
                <TabItem Header="  BATCH UPLOAD QUEUE  ">
                    <ListView x:Name="LvQueue" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" FontFamily="Consolas" SelectionChanged="LvQueue_SelectionChanged" Margin="5">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="STATUS" Width="105">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Status}" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#5A759E"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="QUEUED">
                                                                <Setter Property="Foreground" Value="#00E5FF"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="UPLOADING...">
                                                                <Setter Property="Foreground" Value="#FFFF00"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="DONE">
                                                                <Setter Property="Foreground" Value="#00FF66"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="CORE_ID" DisplayMemberBinding="{Binding GameId}" Width="115"/>
                                <GridViewColumn Header="DATA_LABEL (KLIK OM TE EDITEN)" DisplayMemberBinding="{Binding Title}" Width="350"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </TabItem>

                <TabItem Header="  INSTALLED GAMES ON PS2  ">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ListView x:Name="LvPs2Disk" Grid.Row="0" Background="Transparent" BorderThickness="0" Foreground="#00FF66" FontFamily="Consolas" Margin="5">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="PARTITION / ID" DisplayMemberBinding="{Binding GameId}" Width="150"/>
                                    <GridViewColumn Header="GAME TITLE ON HARD DRIVE" DisplayMemberBinding="{Binding Title}" Width="400"/>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <TextBlock x:Name="TxtNoConnection" Grid.Row="0" Text="NO LIVE CONNECTION // CLICK 'CONNECT' TO SCAN CONSOLE" Foreground="#FF3C3C" FontFamily="Consolas" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        <!-- Dit binnenste Grid met 3 kolommen houdt de knoppen netjes onderin! -->
                        <Grid Grid.Row="1" Margin="10,5,10,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="BtnReloadGames" 
                                    Grid.Column="0"
                                    Style="{StaticResource CyberButtonStyle}"
                                    Content="[ ↻ ] RELOAD GAMES LIST" 
                                    FontFamily="Consolas" 
                                    FontWeight="Bold" 
                                    FontSize="12" 
                                    Padding="0,10" 
                                    Background="#111827" 
                                    Foreground="#00FF66" 
                                    BorderBrush="#00FF66" 
                                    BorderThickness="1" 
                                    IsEnabled="False"
                                    Click="BtnReloadGames_Click"/>

                            <Button x:Name="BtnDeleteGame" 
                                    Grid.Column="2"
                                    Style="{StaticResource CyberButtonStyle}"
                                    Content="[ X ] DELETE SELECTED GAME" 
                                    FontFamily="Consolas" 
                                    FontWeight="Bold" 
                                    FontSize="12" 
                                    Padding="0,10" 
                                    Background="#1A1118" 
                                    Foreground="#FF3C3C" 
                                    BorderBrush="#FF3C3C" 
                                    BorderThickness="1" 
                                    IsEnabled="False"
                                    Click="BtnDeleteGame_Click"/>
                        </Grid>
                    </Grid>
                </TabItem>

            </TabControl>
            <Button Content="Exit Program" HorizontalAlignment="Center" Margin="0,362,0,0" VerticalAlignment="Top" Width="420" Height="27" Background="{x:Null}" Foreground="#FFFFD306" BorderBrush="#FFF3CA09" Click="Button_Click"/>
        </Grid>
        <!-- RIJ 2: Log Terminal -->
        <Border Grid.Row="2" BorderBrush="#1F293D" BorderThickness="1" CornerRadius="4" Background="#050811" Padding="10" Margin="0,0,0,15">
            <DockPanel>
                <TextBlock Text="[ LOG MATRIX TERMINAL ]" DockPanel.Dock="Top" Foreground="#5A759E" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtLog" Background="Transparent" Foreground="#A0A0AA" BorderThickness="0" FontFamily="Consolas" FontSize="12" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" AcceptsReturn="True"/>
            </DockPanel>
        </Border>

        <!-- RIJ 3: Status, Snelheid, ProgressBar & Startknop -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Center">
                <Grid Margin="0,0,0,4">
                    <TextBlock x:Name="StatusText" Text=">> AWAITING OPERATOR DATA RECRUITMENT..." Foreground="#5A759E" FontFamily="Consolas" FontSize="12" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="PercentageText" Text="00.0%" Foreground="#00E5FF" FontFamily="Consolas" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right" Effect="{StaticResource TextGlow}"/>
                </Grid>

                <Grid Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <TextBlock Text="XFER_SPEED: " Foreground="#5A759E" FontFamily="Consolas" FontSize="11"/>
                        <TextBlock x:Name="TxtSpeed" Text="0.00 MB/s" Foreground="#FFFF00" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Margin="5,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="TIME_REMAINING: " Foreground="#5A759E" FontFamily="Consolas" FontSize="11"/>
                        <TextBlock x:Name="TxtEta" Text="00:00:00" Foreground="#00FF66" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Margin="5,0,0,0"/>
                    </StackPanel>
                </Grid>

                <Border BorderBrush="#00E5FF" BorderThickness="1" Padding="2" Background="#070A12" CornerRadius="2">
                    <ProgressBar x:Name="MyProgressBar" Height="14" Minimum="0" Maximum="100" Value="0" Background="Transparent" Foreground="#00E5FF" BorderThickness="0"/>
                </Border>
            </StackPanel>

            <Button x:Name="BtnInstall" Grid.Column="1" Content="EXECUTE BATCH STREAM" Padding="30,0" Width="280" Height="50" Background="#00E5FF" Foreground="#070A12" FontFamily="Consolas" FontSize="14" FontWeight="Bold" BorderThickness="0" Effect="{StaticResource NeonGlow}" Click="BtnInstall_Click" VerticalAlignment="Bottom"/>
        </Grid>
    </Grid>
</Window>
